# Public Supabase configuration. Placeholders only; copy this file to .env and fill it in.
#
# Both values are PUBLIC: they are compiled into the browser bundle and are safe
# to expose, because access is enforced by Row Level Security in the database.
#   Dashboard: Project Settings -> API -> Project URL, and the anon (or publishable) key.
#
# NEVER put the service-role / secret key, the database password, or a database
# connection string in a VITE_ variable (or anywhere in this frontend project).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# To use the Django + SQLite backend instead of Supabase (see README, "Backend (Django)"), uncomment both lines.
# The API address is public; the server keeps its own secrets in backend/.env (never in a VITE_ variable).
# VITE_BACKEND=django
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Only for scripts/verify-supabase.mjs (see docs/SUPABASE_SETUP.md section 6). Leave these commented out for normal
# development. They are NOT VITE_ variables, so they are never bundled. Use a dedicated, disposable TEST project only.
# ARCLOOP_TEST_PROJECT_REF=<the test project ref>
# ARCLOOP_CONFIRM_TEST_PROJECT=yes

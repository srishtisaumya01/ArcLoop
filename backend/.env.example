# Arcloop API (Django) settings. Copy to backend/.env (git-ignored) and fill in. Real environment variables win.
# Nothing here is ever sent to the browser.

# Local development: a built-in insecure key is used and errors are shown in full. Must be false in production.
DJANGO_DEBUG=true

# Required when DJANGO_DEBUG is false. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# DJANGO_SECRET_KEY=

# Comma-separated. Defaults to localhost,127.0.0.1 in debug; required otherwise.
# DJANGO_ALLOWED_HOSTS=

# Where the Vite app runs. Defaults to the Vite dev server in debug; required otherwise.
# CORS is not needed: the app and API share one origin (/api/ is proxied; see docs/DEPLOYMENT.md). Leave empty.
# CORS_ALLOWED_ORIGINS=
# FRONTEND_URL=http://localhost:5173

# SQLite file. Defaults to backend/db.sqlite3.
# DJANGO_DB_PATH=

# Password-reset emails. Debug prints them to the console; production needs a real backend and sender.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_FROM_EMAIL=Arcloop <no-reply@example.com>

# Sign-in token lifetime (days) and rate limit for the public auth endpoints.
# DJANGO_TOKEN_LIFETIME_DAYS=7
# DJANGO_AUTH_THROTTLE=30/min

# SMTP for password-reset emails (production). Credentials live here or in the real environment only.
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=true
# For automated tests only: write emails to files instead of sending them.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
# DJANGO_EMAIL_FILE_PATH=

# --- Production (see docs/DEPLOYMENT.md). Required when DJANGO_DEBUG is false: DJANGO_SECRET_KEY, DJANGO_ALLOWED_HOSTS,
# --- FRONTEND_URL (https://...). All values below are examples; none is a real secret.
# FRONTEND_URL=https://app.example.com
# DJANGO_BACKUP_DIR=/var/backups/arcloop          # keep OFF the database's disk (docs/BACKUP_RESTORE.md)
# DJANGO_PASSWORD_RESET_TIMEOUT=3600              # seconds a reset link lasts
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com   # only for the admin on an https origin
# DJANGO_LOG_LEVEL=INFO
# DJANGO_CSP_REPORT_THROTTLE=60/min
# HSTS: leave unset (off) until HTTPS is confirmed on the real domain; then raise 300 -> 86400 -> 31536000.
# DJANGO_HSTS_SECONDS=0
# DJANGO_BEHIND_PROXY=true                        # only behind a TLS-terminating proxy that sets X-Forwarded-Proto
